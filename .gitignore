# virtualenv / build
.venv/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# local data: databases and their WAL sidecars
*.db
*.db-wal
*.db-shm

# runtime logs written by the launchd agents
*.log

# local config, generated by `gittrack init` (see gittrack.example.toml)
gittrack.toml

# secrets
.env

# conversation exports (/export) land in the repo root as dated .txt files and
# contain the full transcript - tokens, addresses, hostnames. never commit one.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
/*.transcript.txt
